# Ключи runtime-конфига. Префикс NUXT_ обязателен — без него значения
# запекаются в образ при сборке и не обновляются без пересборки.

# Steam API ключ (https://steamcommunity.com/dev/apikey)
NUXT_STEAM_API_KEY=твой_ключ

# Твой Steam ID (числовой, не имя профиля)
NUXT_STEAM_ID=твой_steam_id

# GitHub-токен: с ним лимит API 5000/час вместо 60 (https://github.com/settings/tokens)
NUXT_GITHUB_TOKEN=

# Домен для Caddy (только для Docker-деплоя)
DOMAIN=твой-сайт.ru
